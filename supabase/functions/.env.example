# Telegram bot (tg-webhook, cron-monitor) — names only. Real values live ONLY in Supabase Secrets
# (Dashboard → Edge Functions → Secrets, or `supabase secrets set`). Never commit a filled-in copy.
# For local `supabase functions serve` copy this to supabase/functions/.env (git-ignored).

# @BotFather token
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram user ID
OWNER_CHAT_ID=
# Other admins' numeric Telegram user IDs, comma-separated (e.g. 123456789). The bot answers only these + OWNER_CHAT_ID.
ADMIN_CHAT_IDS=
# Random string, A-Z a-z 0-9 _ - only; same value as setWebhook secret_token
TG_WEBHOOK_SECRET=
# Random string; same value as the Vault secret bot_cron_secret
BOT_CRON_SECRET=
# Transaction pooler URL for the bot_reader role (port 6543), e.g.
# postgresql://bot_reader.ldbthwpikixtykwmvudy:<password>@<pooler-host>:6543/postgres
BOT_DB_URL=
